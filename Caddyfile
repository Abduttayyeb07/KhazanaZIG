# Reverse proxy for the ZIG Khazana console.
#
# This box's port 80/443 already belong to a shared haproxy instance routing
# several OTHER live domains (wickhub.cc, zigscan.org, fracks.xyz, arkive.live)
# that this deployment does not own and must not disturb. So Caddy runs on its
# own port (8443) with a self-signed internal CA instead of fighting haproxy
# for 80/443 or requesting a haproxy config change on a shared box.
#
# Everything is still served from ONE origin: Caddy terminates TLS, serves the
# dashboard, and forwards /api and /ws to the engine - relative URLs from the
# browser, and the session cookie stays first-party.
#
# First visit will show a browser TLS warning (self-signed, not from a public
# CA) - click through once, or trust Caddy's root CA
# (/root/.local/share/caddy/pki/authorities/local/root.crt on the server) on
# each device to remove it permanently.
#
#   sudo apt install caddy
#   sudo cp Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

{
	# Automatic TLS normally also provisions an HTTP->HTTPS redirect listener on
	# :80 for every site, regardless of what port the site itself is on - that's
	# a SEPARATE listener from the site block below, and it's what was colliding
	# with haproxy on :80 even though nothing here asks for port 80 directly.
	# There is nothing on port 80 to redirect FROM in this setup, so disable it.
	auto_https disable_redirects
}

:8443 {
	tls internal

	encode zstd gzip

	# WebSocket for live state. Caddy passes the Upgrade headers through, but the
	# path has to be matched before the catch-all or it would reach the dashboard.
	@ws path /ws
	reverse_proxy @ws 127.0.0.1:3101

	# API + control plane. The operator token and session cookie cross here, which
	# is precisely why this must be HTTPS and not a raw port.
	reverse_proxy /api/* 127.0.0.1:3101
	reverse_proxy /health 127.0.0.1:3101

	# Everything else is the dashboard.
	reverse_proxy 127.0.0.1:3100

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
